{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.grave.cash" }],
      "destination": "/app"
    },
    {
      "source": "/deploy",
      "has": [{ "type": "host", "value": "app.grave.cash" }],
      "destination": "/app/deploy"
    },
    { "source": "/", "destination": "/landing" }
  ]
}
